# Google Maps API Key (Requires Maps JavaScript API enabled)
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Backend Server (optional if running locally or deployed on Render/Railway)
VITE_BACKEND_URL=

# Supabase Storage for Videos & Analysis
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
VITE_SUPABASE_BUCKET=traffic-videos
VITE_SUPABASE_VIDEO_URL=
